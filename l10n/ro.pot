msgid "Authentication required"
msgstr "Autentificare necesară"

#. TRANSLATORS: This is a status message, shown when the system is checking
#. the users password
msgid "Checking password …"
msgstr "Se verifică parola …"

msgid "Confirm"
msgstr "Confirmă"

msgid "Password"
msgstr "Parolă"

msgid "Please confirm your password to proceed."
msgstr "Confirmă-ți parola pentru a continua."

msgid "Please enter your password"
msgstr "Introdu-ți parola"

msgid ""
"This action needs authentication, please confirm it by entering your "
"password."
msgstr ""
"Această acțiune necesită autentificare. Confirm-o introducându-ți parola."

msgid "Wrong password"
msgstr "Parolă incorectă"
