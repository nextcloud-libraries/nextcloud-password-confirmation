msgid "Authentication required"
msgstr "Auðkenningar krafist"

#. TRANSLATORS: This is a status message, shown when the system is checking
#. the users password
msgid "Checking password …"
msgstr "Athuga lykilorð …"

msgid "Confirm"
msgstr "Staðfesta"

msgid "Password"
msgstr "Lykilorð"

msgid "Please enter your password"
msgstr "Settu inn lykilorðið þitt"

msgid ""
"This action needs authentication, please confirm it by entering your "
"password."
msgstr ""
"Þessi aðgerð krefst auðkenningar, staðfestu hana með því að setja inn "
"lykilorðið þitt."

msgid "Wrong password"
msgstr "Rangt lykilorð"
