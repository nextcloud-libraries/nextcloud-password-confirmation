msgid "Authentication required"
msgstr "Authentifizéierung erfuerderlech"

#. TRANSLATORS: This is a status message, shown when the system is checking
#. the users password
msgid "Checking password …"
msgstr "Passwuert préiwen …"

msgid "Confirm"
msgstr "Bestätegen"

msgid "Password"
msgstr "Passwuert"

msgid "Please enter your password"
msgstr "Wannechgelift gëff däi Passwuert an"

msgid ""
"This action needs authentication, please confirm it by entering your "
"password."
msgstr ""
"Fir dës Aktioun ass eng Authentifizéierung erfuerderlech. Wannechgelift "
"bestäteg dës duerch d'Aginn vun dengem Passwuert."

msgid "Wrong password"
msgstr "Falscht Passwuert"
