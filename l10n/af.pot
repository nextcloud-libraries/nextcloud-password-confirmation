msgid "Authentication required"
msgstr "Verifikasie vereis"

#. TRANSLATORS: This is a status message, shown when the system is checking
#. the users password
msgid "Checking password …"
msgstr "Wagwoord word nagegaan ..."

msgid "Confirm"
msgstr "Bevestig"

msgid "Password"
msgstr "Wagwoord"

msgid "Please enter your password"
msgstr "Voer asseblief wagwoord in"

msgid ""
"This action needs authentication, please confirm it by entering your "
"password."
msgstr ""
"Hierdie handeling vereis verifikasie. Bevestig dit asseblief deur jou "
"wagwoord in te voer."

msgid "Wrong password"
msgstr "Verkeerde wagwoord"
