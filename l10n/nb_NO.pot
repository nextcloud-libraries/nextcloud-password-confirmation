msgid "Authentication required"
msgstr "Autentisering påkrevd"

#. TRANSLATORS: This is a status message, shown when the system is checking
#. the users password
msgid "Checking password …"
msgstr "Sjekker passordet …"

msgid "Confirm"
msgstr "Bekreft"

msgid "Password"
msgstr "Passord"

msgid "Please enter your password"
msgstr "Vennligst skriv inn passordet ditt"

msgid ""
"This action needs authentication, please confirm it by entering your "
"password."
msgstr "Denne handlingen krever autentisering; vennligst angi ditt passord."

msgid "Wrong password"
msgstr "Feil passord"
